actionset "work-judgement-actions"
  # Work judgement: every agent who knows a work occurrence happened says what
  # it calls it, recorded as ?SELF.judgedAs(?OCC, label). A stub: Mike
  # authors the real labels.
  #
  # A label that names someone can name only who ?SELF could hold
  # responsible (couldBeResponsible, definitions.rue): the one ?SELF knows did
  # it, or, when ?SELF knows of no one, anyone. Naming someone records that
  # ?SELF holds them responsible, in ?SELF's own store. "Bad luck" and "no
  # real opinion" name no one.
  #
  # Stand-in effects on how ?SELF regards ?X, in ?SELF's own store: selfish
  # lowers liking and trust and adds to a grudge, careless lowers trust, fair
  # raises trust, generous raises both and adds to gratitude.
  #
  # No label is hidden because of what changed: whether an outcome was good or
  # bad for ?SELF is for ?SELF's own strategy. Utilities are sums of the
  # shared impulses (warm, hostile, trusting, wary, charitable, reserved),
  # primed by social-priming.rue.

  action "call it selfish"
    roles: ?SELF: agent, ?OCC: occurrence, ?X: agent
    preconditions
      ?SELF.witnessed(?OCC, ?SELF)
      ^ work_occurrence(?OCC)
      ^ not judged(?SELF, ?OCC)
      ^ couldBeResponsible(?SELF, ?OCC, ?X)
    utility
      impulse-hostile(?SELF, ?X)
    content text: "?SELF calls it selfish of ?X"
    effects
      judged(?SELF, ?OCC)
      ?SELF.judgedAs(?OCC, "selfish")
      ?SELF.responsible(?OCC, ?X)
      ?SELF.likes(?SELF, ?X) -= 1
      ?SELF.trusts(?SELF, ?X) -= 1
      ?SELF.grudge(?SELF, ?X) += 1

  action "call it careless"
    roles: ?SELF: agent, ?OCC: occurrence, ?X: agent
    preconditions
      ?SELF.witnessed(?OCC, ?SELF)
      ^ work_occurrence(?OCC)
      ^ not judged(?SELF, ?OCC)
      ^ couldBeResponsible(?SELF, ?OCC, ?X)
    utility
      impulse-hostile(?SELF, ?X) / 2 + impulse-charitable(?SELF) / 2
    content text: "?SELF calls it careless of ?X"
    effects
      judged(?SELF, ?OCC)
      ?SELF.judgedAs(?OCC, "careless")
      ?SELF.responsible(?OCC, ?X)
      ?SELF.trusts(?SELF, ?X) -= 1

  action "call it fair"
    roles: ?SELF: agent, ?OCC: occurrence, ?X: agent
    preconditions
      ?SELF.witnessed(?OCC, ?SELF)
      ^ work_occurrence(?OCC)
      ^ not judged(?SELF, ?OCC)
      ^ couldBeResponsible(?SELF, ?OCC, ?X)
    utility
      impulse-warm(?SELF, ?X) / 2 + impulse-charitable(?SELF) / 2
    content text: "?SELF calls it fair of ?X"
    effects
      judged(?SELF, ?OCC)
      ?SELF.judgedAs(?OCC, "fair")
      ?SELF.responsible(?OCC, ?X)
      ?SELF.trusts(?SELF, ?X) += 1

  action "call it generous"
    roles: ?SELF: agent, ?OCC: occurrence, ?X: agent
    preconditions
      ?SELF.witnessed(?OCC, ?SELF)
      ^ work_occurrence(?OCC)
      ^ not judged(?SELF, ?OCC)
      ^ couldBeResponsible(?SELF, ?OCC, ?X)
    utility
      impulse-warm(?SELF, ?X)
    content text: "?SELF calls it generous of ?X"
    effects
      judged(?SELF, ?OCC)
      ?SELF.judgedAs(?OCC, "generous")
      ?SELF.responsible(?OCC, ?X)
      ?SELF.likes(?SELF, ?X) += 1
      ?SELF.trusts(?SELF, ?X) += 1
      ?SELF.grateful(?SELF, ?X) += 1

  action "call it bad luck"
    roles: ?SELF: agent, ?OCC: occurrence
    preconditions
      ?SELF.witnessed(?OCC, ?SELF)
      ^ work_occurrence(?OCC)
      ^ not judged(?SELF, ?OCC)
    utility
      impulse-charitable(?SELF)
    content text: "?SELF calls it bad luck"
    effects
      judged(?SELF, ?OCC)
      ?SELF.judgedAs(?OCC, "bad luck")

  action "no real opinion of the work"
    roles: ?SELF: agent, ?OCC: occurrence
    preconditions
      ?SELF.witnessed(?OCC, ?SELF)
      ^ work_occurrence(?OCC)
      ^ not judged(?SELF, ?OCC)
    utility
      impulse-reserved(?SELF)
    content text: "?SELF has no real opinion of it"
    effects
      judged(?SELF, ?OCC)
      ?SELF.judgedAs(?OCC, "no real opinion")
