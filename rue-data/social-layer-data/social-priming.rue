ruleset "social-priming"
  # Priming for every social choice. Rules read social facts on the left-hand
  # side (labels, responsibility, likes, trusts, leftAlone, ...) and add to,
  # or subtract from, the shared impulses that every action's utility sums:
  #   impulse-warm(?A, ?B)      the pull toward thinking and speaking well of ?B
  #   impulse-hostile(?A, ?B)   the pull toward thinking and speaking ill of ?B
  #   impulse-trusting(?A, ?B)  the pull toward believing and confiding in ?B
  #   impulse-wary(?A, ?B)      the pull toward doubting what ?B says
  #   impulse-charitable(?A)    the pull toward the benefit of the doubt
  #   impulse-reserved(?A)      the pull toward keeping out of it
  #   impulse-conciliatory(?A, ?B) the pull toward mending things with ?B
  # Impulses are ephemeral (reset every tick) and may go negative.
  #
  # The priming rules of all three stages (work judgement, social actions,
  # social judgement), marked fresh: the impulses are cleared before each run,
  # so each choice is scored from the current facts rather than adding up
  # across stages and loop invocations. Labels given in work judgement reach
  # this tick's social actions.
  #
  # Every stage binds the agent choosing as ?SELF, and priming runs for that
  # one binding, so rules prime ?SELF's impulses. (Write them about ?SELF, not
  # a fresh ?A: RUE keeps same-type variables distinct, so ?A could never be
  # the agent choosing.)
  #
  # Tier 1 (single-premise rules), first pass, Nov 7: see
  # authoring/social-priming.session.json for what was considered and left
  # out. Mike reviews them.
  #
  # How much ?SELF likes and trusts ?B (0-10, 5 is neutral): the distance
  # from neutral becomes the matching impulse, so liking ?B at 8 makes ?SELF
  # warm toward ?B by 3.

  rule "likes them: warm"
    ?SELF.likes(?SELF, ?B) > 5
    => impulse-warm(?SELF, ?B) += ?SELF.likes(?SELF, ?B) - 5

  rule "dislikes them: hostile"
    ?SELF.likes(?SELF, ?B) < 5
    => impulse-hostile(?SELF, ?B) += 5 - ?SELF.likes(?SELF, ?B)

  rule "trusts them: trusting"
    ?SELF.trusts(?SELF, ?B) > 5
    => impulse-trusting(?SELF, ?B) += ?SELF.trusts(?SELF, ?B) - 5

  rule "distrusts them: wary"
    ?SELF.trusts(?SELF, ?B) < 5
    => impulse-wary(?SELF, ?B) += 5 - ?SELF.trusts(?SELF, ?B)

  # Liking and trust spill over a little: we believe people we like, doubt
  # people we don't, and warm to people we trust.

  rule "likes them: inclined to believe them"
    ?SELF.likes(?SELF, ?B) > 5
    => impulse-trusting(?SELF, ?B) += 1

  rule "dislikes them: inclined to doubt them"
    ?SELF.likes(?SELF, ?B) < 5
    => impulse-wary(?SELF, ?B) += 1

  rule "trusts them: warms to them"
    ?SELF.trusts(?SELF, ?B) > 5
    => impulse-warm(?SELF, ?B) += 1

  # Counts: these fire once per colleague, so they stack.

  rule "each colleague liked: more charitable"
    ?SELF.likes(?SELF, ?OTHER) > 5
    => impulse-charitable(?SELF) += 1

  rule "each colleague distrusted: more guarded"
    ?SELF.trusts(?SELF, ?OTHER) < 5
    => impulse-reserved(?SELF) += 1

  # What ?SELF has been calling things lately (labels given this round or
  # last; each label counts, so they stack). Labels are records that never go
  # away, so without the window they would pile up over a long run.

  rule "called something selfish lately: less charitable"
    ?SELF.judgedAs(?O, "selfish") [asserted-during: 2]
    => impulse-charitable(?SELF) -= 1

  rule "called something fair lately: more charitable"
    ?SELF.judgedAs(?O, "fair") [asserted-during: 2]
    => impulse-charitable(?SELF) += 1

  rule "called something generous lately: more charitable"
    ?SELF.judgedAs(?O, "generous") [asserted-during: 2]
    => impulse-charitable(?SELF) += 1

  rule "called something bad luck lately: more charitable"
    ?SELF.judgedAs(?O, "bad luck") [asserted-during: 2]
    => impulse-charitable(?SELF) += 1


  # Left alone: nobody did anything to ?SELF this round that ?SELF can put a
  # name to, so less to say.

  rule "left alone this round: more reserved"
    leftAlone(?SELF)
    => impulse-reserved(?SELF) += 1

  # Involvement: someone ?SELF holds responsible for something this round (they
  # did something ?SELF witnessed, publicly or not, or ?SELF named them) gives
  # ?SELF something to say about them, either way: it raises warm and hostile
  # alike and lowers reserved. It never says whether what they did was good or
  # bad; the agent's choice does (Nov 7, after a run where neutrality locked
  # in: no other option had any pull, and each neutral verdict fed the next).
  # Written with ?OCC: a judgement stage binds the occurrence being judged as
  # ?OCC, so these read that one event there (a fresh ?O could never be it:
  # RUE keeps same-type variables distinct), and every recent one elsewhere.

  rule "someone did something you know of: warmer toward them"
    ?SELF.responsible(?OCC, ?B) [asserted-during: 1]
    => impulse-warm(?SELF, ?B) += 1

  rule "someone did something you know of: more hostile toward them"
    ?SELF.responsible(?OCC, ?B) [asserted-during: 1]
    => impulse-hostile(?SELF, ?B) += 1

  rule "someone did something you know of: less reserved"
    ?SELF.responsible(?OCC, ?B) [asserted-during: 1]
    => impulse-reserved(?SELF) -= 1

  # ── Tier 1, second pass (Nov 7): traits and the richer relationships ──
  # Traits are ?SELF's own (in its own store). A trait alone can only move
  # the impulses about ?SELF (charitable, reserved); how a trait colours a
  # particular relationship (loyal to a friend) needs a second premise, tier 2.

  rule "forgiving: gives the benefit of the doubt"
    ?SELF.forgiving(?SELF)
    => impulse-charitable(?SELF) += 2

  rule "suspicious: slow to give the benefit of the doubt"
    ?SELF.suspicious(?SELF)
    => impulse-charitable(?SELF) -= 1

  rule "proud: slow to give the benefit of the doubt"
    ?SELF.proud(?SELF)
    => impulse-charitable(?SELF) -= 1

  rule "gossipy: likes to talk"
    ?SELF.gossipy(?SELF)
    => impulse-reserved(?SELF) -= 2

  rule "easygoing: gives the benefit of the doubt"
    ?SELF.easygoing(?SELF)
    => impulse-charitable(?SELF) += 1

  rule "easygoing: content to keep out of it"
    ?SELF.easygoing(?SELF)
    => impulse-reserved(?SELF) += 1

  # A grudge and gratitude, in proportion to how strongly ?SELF holds them.

  rule "a grudge: hostile"
    ?SELF.grudge(?SELF, ?B) > 0
    => impulse-hostile(?SELF, ?B) += ?SELF.grudge(?SELF, ?B)

  rule "a grudge: in no mood to make up"
    ?SELF.grudge(?SELF, ?B) > 0
    => impulse-conciliatory(?SELF, ?B) -= 1

  rule "gratitude: warm"
    ?SELF.grateful(?SELF, ?B) > 0
    => impulse-warm(?SELF, ?B) += ?SELF.grateful(?SELF, ?B)

  rule "gratitude: wants things good between you"
    ?SELF.grateful(?SELF, ?B) > 0
    => impulse-conciliatory(?SELF, ?B) += 1

  rule "liking: wants things good between you"
    ?SELF.likes(?SELF, ?B) > 5
    => impulse-conciliatory(?SELF, ?B) += 1

  # Friends and rivals.

  rule "a friend: warm"
    ?SELF.friends(?SELF, ?B)
    => impulse-warm(?SELF, ?B) += 2

  rule "a friend: trusting"
    ?SELF.friends(?SELF, ?B)
    => impulse-trusting(?SELF, ?B) += 2

  rule "a friend: wants things good between you"
    ?SELF.friends(?SELF, ?B)
    => impulse-conciliatory(?SELF, ?B) += 1

  rule "a rival: hostile"
    ?SELF.rival(?SELF, ?B)
    => impulse-hostile(?SELF, ?B) += 1

  rule "a rival: wary"
    ?SELF.rival(?SELF, ?B)
    => impulse-wary(?SELF, ?B) += 2

  # What ?SELF has come to believe about someone (from gossip it believed).

  rule "believes they're selfish: hostile"
    ?SELF.believes(?SELF, ?B, "selfish")
    => impulse-hostile(?SELF, ?B) += 2

  rule "believes they're careless: wary"
    ?SELF.believes(?SELF, ?B, "careless")
    => impulse-wary(?SELF, ?B) += 2

  rule "believes they're generous: warm"
    ?SELF.believes(?SELF, ?B, "generous")
    => impulse-warm(?SELF, ?B) += 2

  rule "believes they're fair: trusting"
    ?SELF.believes(?SELF, ?B, "fair")
    => impulse-trusting(?SELF, ?B) += 2

  # ── Repetition (Nov 7) ──
  # Something ?SELF expressed in the last three rounds (this one included)
  # pulls less the next time: impulse-already-expressed, which that action's
  # utility subtracts. Only the same thing to the same person; a different
  # claim, or the same claim to someone else, is unaffected. One rule per
  # label, since a variable in a label slot matches nothing.

  rule "told them someone is selfish recently: less to add"
    ?SELF.expressed(?SELF, ?Y, ?B, "selfish") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?Y, ?B, "selfish") += 3

  rule "told them someone is careless recently: less to add"
    ?SELF.expressed(?SELF, ?Y, ?B, "careless") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?Y, ?B, "careless") += 3

  rule "told them someone is generous recently: less to add"
    ?SELF.expressed(?SELF, ?Y, ?B, "generous") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?Y, ?B, "generous") += 3

  rule "told them someone is fair recently: less to add"
    ?SELF.expressed(?SELF, ?Y, ?B, "fair") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?Y, ?B, "fair") += 3

  rule "confronted them recently: less to add"
    ?SELF.expressedDirectly(?SELF, ?B, "confronted") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?B, ?B, "confronted") += 3

  rule "thanked them recently: less to add"
    ?SELF.expressedDirectly(?SELF, ?B, "thanked") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?B, ?B, "thanked") += 3

  rule "apologised to them recently: less to add"
    ?SELF.expressedDirectly(?SELF, ?B, "apologised to") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?B, ?B, "apologised to") += 3

  rule "given the cold shoulder to them recently: less to add"
    ?SELF.expressedDirectly(?SELF, ?B, "given the cold shoulder to") [asserted-during: 3]
    => impulse-already-expressed(?SELF, ?B, ?B, "given the cold shoulder to") += 3

  # ── Tier 2, first pass (exp/4-firsthand, Nov 8): what ?SELF saw for itself ──
  # A label ?SELF gave, in the last three rounds, to something it saw ?B do
  # (?B is the occurrence's credited actor, as far as ?SELF knows) pulls
  # ?SELF toward the matching view of ?B. What ?SELF saw then weighs against
  # what it's told: a claim that ?B is selfish meets ?SELF's own verdict that
  # ?B was fair, shown as a reason on the menu ("You were there: ..."). Blame
  # ?SELF assigned for something nobody was credited with doesn't count: in
  # exp/5 a first version that counted it amplified self-serving blame.
  # Weights are first guesses, for Mike's review.

  rule "you called what they did fair yourself: trusting"
    ?SELF.judgedAs(?O, "fair") [asserted-during: 3] ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-trusting(?SELF, ?B) += 1

  rule "you called what they did fair yourself: warm"
    ?SELF.judgedAs(?O, "fair") [asserted-during: 3] ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-warm(?SELF, ?B) += 1

  rule "you called what they did generous yourself: warm"
    ?SELF.judgedAs(?O, "generous") [asserted-during: 3] ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-warm(?SELF, ?B) += 2

  rule "you called what they did selfish yourself: hostile"
    ?SELF.judgedAs(?O, "selfish") [asserted-during: 3] ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-hostile(?SELF, ?B) += 2

  rule "you called what they did careless yourself: wary"
    ?SELF.judgedAs(?O, "careless") [asserted-during: 3] ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-wary(?SELF, ?B) += 1

  # ── Tier 2: second premises tier 1 deferred (Nov 8) ──
  # Loyal is a trait about friends, so alone it says nothing (tier 1 left it
  # out); with the friendship it pulls ?SELF toward its friends.

  rule "loyal to a friend: warm"
    ?SELF.loyal(?SELF) ^ ?SELF.friends(?SELF, ?B)
    => impulse-warm(?SELF, ?B) += 2

  # Being confided in: ?S chose to tell ?SELF something about someone else
  # (the claim ?SELF is judging, or one made to it this round). witnessed
  # marks the listener: a claim ?SELF made is in its own store too. Being taken
  # into someone's confidence pulls toward believing them. Tier 1 left role
  # out because being confided in needs the speaker.

  rule "confided in: trusting toward them"
    ?SELF.witnessed(?OCC, ?SELF) ^ ?SELF.role(?OCC, SELF, ?S) [asserted-during: 1] ^ ?SELF.role(?OCC, OTHER, ?B)
    => impulse-trusting(?SELF, ?S) += 1

  # ── Tier 2: third parties (Mike, Nov 8) ──
  # Three agents: ?SELF, the one talking (?S) and the one talked about (?B).
  # Most read the claim made to ?SELF this round (?OCC; in social judgement,
  # the claim being judged), so they bite when ?SELF decides what to make of
  # it, and the lasting effect is ?SELF's choice (doubting lowers trust in
  # ?S; believing changes how ?SELF sees ?B). Rows 12–15 also read claims
  # made to ?SELF in the last three rounds, believed or not: the claim
  # occurrences in ?SELF's own store. "Badly" is selfish or careless, "well"
  # is generous or fair; a label slot must be a literal, so each label has
  # its own rule. witnessed marks a claim made *to* ?SELF (a claim ?SELF made
  # is in its own store too). Weights are first guesses. Nobody learns what was said
  # about themselves (only the one spoken to hears a claim).

  # 1. Badmouthing your friend

  rule "your friend called selfish: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-wary(?SELF, ?S) += 2

  rule "your friend called careless: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-wary(?SELF, ?S) += 2

  # 2. …and you're loyal

  rule "loyal, your friend called selfish: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.loyal(?SELF)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-wary(?SELF, ?S) += 1

  rule "loyal, your friend called selfish: hostile to who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.loyal(?SELF)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-hostile(?SELF, ?S) += 1

  rule "loyal, your friend called careless: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.loyal(?SELF)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-wary(?SELF, ?S) += 1

  rule "loyal, your friend called careless: hostile to who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.loyal(?SELF)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-hostile(?SELF, ?S) += 1

  # 3. Praising your friend

  rule "your friend called generous: warm toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is generous") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-warm(?SELF, ?S) += 1

  rule "your friend called fair: warm toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is fair") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.friends(?SELF, ?B)
    => impulse-warm(?SELF, ?S) += 1

  # 4. The enemy of my enemy

  rule "your rival called selfish: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.rival(?SELF, ?B)
    => impulse-trusting(?SELF, ?S) += 1

  rule "your rival called selfish: warm toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.rival(?SELF, ?B)
    => impulse-warm(?SELF, ?S) += 1

  rule "your rival called careless: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.rival(?SELF, ?B)
    => impulse-trusting(?SELF, ?S) += 1

  rule "your rival called careless: warm toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.rival(?SELF, ?B)
    => impulse-warm(?SELF, ?S) += 1

  # 5. Praising your rival

  rule "your rival called generous: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is generous") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.rival(?SELF, ?B)
    => impulse-wary(?SELF, ?S) += 1

  rule "your rival called fair: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is fair") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.rival(?SELF, ?B)
    => impulse-wary(?SELF, ?S) += 1

  # 6. Badmouthing a benefactor

  rule "someone you're grateful to called selfish: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.grateful(?SELF, ?B) > 0
    => impulse-wary(?SELF, ?S) += 1

  rule "someone you're grateful to called careless: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.grateful(?SELF, ?B) > 0
    => impulse-wary(?SELF, ?S) += 1

  # 7. Confirming a grudge

  rule "someone you hold a grudge against called selfish: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.grudge(?SELF, ?B) > 0
    => impulse-trusting(?SELF, ?S) += 1

  rule "someone you hold a grudge against called careless: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.grudge(?SELF, ?B) > 0
    => impulse-trusting(?SELF, ?S) += 1

  # 8. Badmouthing someone you like

  rule "someone you like called selfish: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.likes(?SELF, ?B) > 6
    => impulse-wary(?SELF, ?S) += 1

  rule "someone you like called careless: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.likes(?SELF, ?B) > 6
    => impulse-wary(?SELF, ?S) += 1

  # 9. Telling you what you already believe

  rule "told they're selfish, as you believe: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "selfish")
    => impulse-trusting(?SELF, ?S) += 1

  rule "told they're careless, as you believe: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "careless")
    => impulse-trusting(?SELF, ?S) += 1

  rule "told they're generous, as you believe: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is generous") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "generous")
    => impulse-trusting(?SELF, ?S) += 1

  rule "told they're fair, as you believe: trusting toward who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is fair") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "fair")
    => impulse-trusting(?SELF, ?S) += 1

  # 10. Contradicting what you believe

  rule "told they're selfish, but you believe they're generous: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "generous")
    => impulse-wary(?SELF, ?S) += 1

  rule "told they're selfish, but you believe they're fair: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "fair")
    => impulse-wary(?SELF, ?S) += 1

  rule "told they're careless, but you believe they're generous: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "generous")
    => impulse-wary(?SELF, ?S) += 1

  rule "told they're careless, but you believe they're fair: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "fair")
    => impulse-wary(?SELF, ?S) += 1

  rule "told they're generous, but you believe they're selfish: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is generous") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "selfish")
    => impulse-wary(?SELF, ?S) += 1

  rule "told they're generous, but you believe they're careless: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is generous") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "careless")
    => impulse-wary(?SELF, ?S) += 1

  rule "told they're fair, but you believe they're selfish: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is fair") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "selfish")
