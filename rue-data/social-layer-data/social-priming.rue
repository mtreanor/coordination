    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.judgedAs(?O, "fair") [asserted-during: 3]
    ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-wary(?SELF, ?S) += 2

  # 12. Corroboration

  rule "two people say they're selfish: hostile toward them"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S1)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.witnessed(?O, ?SELF)
    ^ ?SELF.actionType(?O, "say someone is selfish") [asserted-during: 3]
    ^ ?SELF.role(?O, SELF, ?S2)
    ^ ?SELF.role(?O, OTHER, ?B)
    ^ ?S1 != ?S2
    => impulse-hostile(?SELF, ?B) += 2

  rule "two people say they're careless: hostile toward them"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S1)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.witnessed(?O, ?SELF)
    ^ ?SELF.actionType(?O, "say someone is careless") [asserted-during: 3]
    ^ ?SELF.role(?O, SELF, ?S2)
    ^ ?SELF.role(?O, OTHER, ?B)
    ^ ?S1 != ?S2
    => impulse-hostile(?SELF, ?B) += 2

  rule "two people say they're generous: warm toward them"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is generous") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S1)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.witnessed(?O, ?SELF)
    ^ ?SELF.actionType(?O, "say someone is generous") [asserted-during: 3]
    ^ ?SELF.role(?O, SELF, ?S2)
    ^ ?SELF.role(?O, OTHER, ?B)
    ^ ?S1 != ?S2
    => impulse-warm(?SELF, ?B) += 2

  rule "two people say they're fair: warm toward them"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is fair") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S1)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.witnessed(?O, ?SELF)
    ^ ?SELF.actionType(?O, "say someone is fair") [asserted-during: 3]
    ^ ?SELF.role(?O, SELF, ?S2)
    ^ ?SELF.role(?O, OTHER, ?B)
    ^ ?S1 != ?S2
    => impulse-warm(?SELF, ?B) += 2

  # 13. Mixed reports

  rule "told they're selfish and generous by different people: reserved"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S1)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.witnessed(?O, ?SELF)
    ^ ?SELF.actionType(?O, "say someone is generous") [asserted-during: 3]
    ^ ?SELF.role(?O, SELF, ?S2)
    ^ ?SELF.role(?O, OTHER, ?B)
    ^ ?S1 != ?S2
    => impulse-reserved(?SELF) += 1

  rule "told they're generous and selfish by different people: reserved"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is generous") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S1)
