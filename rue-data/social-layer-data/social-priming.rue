    ^ ?SELF.role(?O2, OTHER, ?B2)
    ^ ?B1 != ?B2
    => impulse-warm(?SELF, ?S) += 0.5

  # 16. Suspicious of a confidant

  rule "suspicious, confided in: wary of them"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.role(?OCC, SELF, ?S) [asserted-during: 1]
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.suspicious(?SELF)
    => impulse-wary(?SELF, ?S) += 1

  # 17. Gossipy listener

  rule "gossipy, confided in: warm toward them"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.role(?OCC, SELF, ?S) [asserted-during: 1]
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.gossipy(?SELF)
    => impulse-warm(?SELF, ?S) += 1

  rule "gossipy, confided in: less reserved"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.role(?OCC, SELF, ?S) [asserted-during: 1]
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.gossipy(?SELF)
    => impulse-reserved(?SELF) -= 1
