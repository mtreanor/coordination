    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.witnessed(?O, ?SELF)
    ^ ?SELF.actionType(?O, "say someone is fair") [asserted-during: 3]
    ^ ?SELF.role(?O, SELF, ?S2)
    ^ ?SELF.role(?O, OTHER, ?B)
    ^ ?S1 != ?S2
    => impulse-reserved(?SELF) += 1

  rule "told they're fair and careless by different people: reserved"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is fair") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S1)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.witnessed(?O, ?SELF)
    ^ ?SELF.actionType(?O, "say someone is careless") [asserted-during: 3]
    ^ ?SELF.role(?O, SELF, ?S2)
    ^ ?SELF.role(?O, OTHER, ?B)
    ^ ?S1 != ?S2
    => impulse-reserved(?SELF) += 1

  # 14. A gossip

  rule "they've called different people selfish and selfish lately: wary of them"
    ?SELF.witnessed(?O1, ?SELF)
    ^ ?SELF.actionType(?O1, "say someone is selfish") [asserted-during: 3]
    ^ ?SELF.role(?O1, SELF, ?S)
    ^ ?SELF.role(?O1, OTHER, ?B1)
    ^ ?SELF.witnessed(?O2, ?SELF)
