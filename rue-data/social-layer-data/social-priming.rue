  rule "told they're fair, but you believe they're careless: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is fair") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.believes(?SELF, ?B, "careless")
    => impulse-wary(?SELF, ?S) += 1

  # 11. Contradicting what you saw

  rule "called selfish, but you saw them be generous: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.judgedAs(?O, "generous") [asserted-during: 3]
    ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-wary(?SELF, ?S) += 2

  rule "called selfish, but you saw them be fair: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is selfish") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.judgedAs(?O, "fair") [asserted-during: 3]
    ^ ?SELF.role(?O, ACTOR, ?B)
    => impulse-wary(?SELF, ?S) += 2

  rule "called careless, but you saw them be generous: wary of who said it"
    ?SELF.witnessed(?OCC, ?SELF)
    ^ ?SELF.actionType(?OCC, "say someone is careless") [asserted-during: 1]
    ^ ?SELF.role(?OCC, SELF, ?S)
    ^ ?SELF.role(?OCC, OTHER, ?B)
    ^ ?SELF.judgedAs(?O, "generous") [asserted-during: 3]
