actionset "social-judgement-actions"
  # Social judgement: a listener picks a judgement action for what was said
  # to them. A stub.
  # role SELF is the speaker, role OTHER the agent spoken about.
  # Utilities are sums of the shared impulses (warm, hostile, trusting, wary,
  # charitable, reserved), primed by social-priming.rue.

  action "take the complaint to heart"
    roles: ?JUDGE: agent, ?OCC: occurrence, ?SPEAKER: agent, ?SUBJECT: agent
    preconditions
      witnessed(?OCC, ?JUDGE)
      ^ social_occurrence(?OCC)
      ^ not judged(?JUDGE, ?OCC)
      ^ actionType(?OCC, "complain about someone")
      ^ role(?OCC, SELF, ?SPEAKER)
      ^ role(?OCC, OTHER, ?SUBJECT)
    utility
      impulse-trusting(?JUDGE, ?SPEAKER) + impulse-hostile(?JUDGE, ?SUBJECT)
    content text: "?JUDGE takes ?SPEAKER's complaint about ?SUBJECT to heart"
    effects
      judged(?JUDGE, ?OCC)
      ?JUDGE.likes(?JUDGE, ?SUBJECT) -= 1
      ?JUDGE.trusts(?JUDGE, ?SUBJECT) -= 1

  action "doubt the complaint"
    roles: ?JUDGE: agent, ?OCC: occurrence, ?SPEAKER: agent, ?SUBJECT: agent
    preconditions
      witnessed(?OCC, ?JUDGE)
      ^ social_occurrence(?OCC)
      ^ not judged(?JUDGE, ?OCC)
      ^ actionType(?OCC, "complain about someone")
      ^ role(?OCC, SELF, ?SPEAKER)
      ^ role(?OCC, OTHER, ?SUBJECT)
    utility
      impulse-wary(?JUDGE, ?SPEAKER) + impulse-warm(?JUDGE, ?SUBJECT)
    content text: "?JUDGE doubts ?SPEAKER's complaint about ?SUBJECT"
    effects
      judged(?JUDGE, ?OCC)
      ?JUDGE.trusts(?JUDGE, ?SPEAKER) -= 1

  action "take the praise to heart"
    roles: ?JUDGE: agent, ?OCC: occurrence, ?SPEAKER: agent, ?SUBJECT: agent
    preconditions
      witnessed(?OCC, ?JUDGE)
      ^ social_occurrence(?OCC)
      ^ not judged(?JUDGE, ?OCC)
      ^ actionType(?OCC, "speak well of someone")
      ^ role(?OCC, SELF, ?SPEAKER)
      ^ role(?OCC, OTHER, ?SUBJECT)
    utility
      impulse-trusting(?JUDGE, ?SPEAKER) + impulse-warm(?JUDGE, ?SUBJECT)
    content text: "?JUDGE takes ?SPEAKER's praise of ?SUBJECT to heart"
    effects
      judged(?JUDGE, ?OCC)
      ?JUDGE.likes(?JUDGE, ?SUBJECT) += 1

  action "no real opinion of what was said"
    roles: ?JUDGE: agent, ?OCC: occurrence, ?SPEAKER: agent
    preconditions
      witnessed(?OCC, ?JUDGE)
      ^ social_occurrence(?OCC)
      ^ not judged(?JUDGE, ?OCC)
      ^ role(?OCC, SELF, ?SPEAKER)
    utility
      impulse-reserved(?JUDGE)
    content text: "?JUDGE has no real opinion about what ?SPEAKER said"
    effects
      judged(?JUDGE, ?OCC)
