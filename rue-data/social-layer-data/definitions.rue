define "dealt with this round"
  # Some work occurrence this round that ?A knows about is credited, as far as
  # ?A knows, to someone: public, witnessed, or assigned in work judgement. The
  # window is 1 tick because a tick plan advances the tick before its phases
  # run.
  ?A.witnessed(?O, ?A) ^ ?A.work_occurrence(?O) [asserted-during: 1] ^ ?A.responsible(?O, ?X)
  => dealtWith(?A)

define "left alone this round"
  # Nobody did anything to ?A this round that ?A can put a name to. A fact,
  # not a verdict: it may feel like being shunned (no one invested in you) or
  # like being spared (no one passed you a bug).
  not dealtWith(?A)
  => leftAlone(?A)

define "could be responsible: the one ?J knows did it"
  # Who a label in work judgement can name. When ?J knows who is responsible
  # (public credit, or credit ?J witnessed or assigned), only them.
  ?J.responsible(?O, ?X)
  => couldBeResponsible(?J, ?O, ?X)

define "could be responsible: anyone, when ?J knows of no one"
  # When ?J knows of no one, anyone could be: naming someone in a label is how
  # ?J holds them responsible.
  ?J.witnessed(?O, ?J) ^ not ?J.responsible(?O, _)
  => couldBeResponsible(?J, ?O, ?X)

define "fresh dealings: held them responsible this round"
  # Something new between ?A and ?B this round, from ?A's side: ?A holds ?B
  # responsible for a work occurrence this round (they did it where ?A could
  # see, or ?A named them), or ?A judged something ?B said or did to ?A, or
  # something said to ?A about ?B. Feelings about ?B don't drift back toward
  # neutral in a round like that (social-drift.rue).
  ?A.responsible(?O, ?B) [asserted-during: 1]
  => freshDealings(?A, ?B)

define "fresh dealings: judged what they said or did"
  ?A.judged(?A, ?O) [asserted-during: 1] ^ ?A.social_occurrence(?O) ^ ?A.role(?O, SELF, ?B)
  => freshDealings(?A, ?B)

define "fresh dealings: judged what was said about them"
  ?A.judged(?A, ?O) [asserted-during: 1] ^ ?A.social_occurrence(?O) ^ ?A.role(?O, OTHER, ?B)
  => freshDealings(?A, ?B)

# A fresh grievance: what keeps a bad feeling from fading (social-drift.rue).
# ?A has one against ?B when, this round, ?A called something ?B did selfish
# or careless, something ?A saw ?B do (?B is its credited actor), or ?B
# confronted ?A or gave ?A the cold shoulder. Good dealings don't keep a
# grudge alive (exp/3-reform), and nor does blame ?A assigned for something
# nobody was credited with: in exp/5, passers blamed the one they'd passed to
# for the team's lost hours every sprint, which kept the grudge, and the
# passing, going.

define "fresh grievance: called what they did selfish"
  ?A.judgedAs(?O, "selfish") [asserted-during: 1] ^ ?A.role(?O, ACTOR, ?B)
  => freshGrievance(?A, ?B)

define "fresh grievance: called what they did careless"
  ?A.judgedAs(?O, "careless") [asserted-during: 1] ^ ?A.role(?O, ACTOR, ?B)
  => freshGrievance(?A, ?B)

define "fresh grievance: confronted by them"
  ?A.judged(?A, ?O) [asserted-during: 1] ^ ?A.actionType(?O, "confront someone") ^ ?A.role(?O, SELF, ?B)
  => freshGrievance(?A, ?B)

define "fresh grievance: given the cold shoulder by them"
  ?A.judged(?A, ?O) [asserted-during: 1] ^ ?A.actionType(?O, "give someone the cold shoulder") ^ ?A.role(?O, SELF, ?B)
  => freshGrievance(?A, ?B)
