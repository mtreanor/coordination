{
  "predicates": {
    "points": {
      "type": "numeric",
      "args": [
        "agent"
      ],
      "default": 0
    },
    "likes": {
      "type": "numeric",
      "args": [
        "agent",
        "agent"
      ],
      "minValue": 0,
      "maxValue": 10,
      "default": 5,
      "toString": {
        "state": "You like them {value} out of 10.",
        "reason": "You like {args[1]} {value} out of 10."
      }
    },
    "trusts": {
      "type": "numeric",
      "args": [
        "agent",
        "agent"
      ],
      "minValue": 0,
      "maxValue": 10,
      "default": 5,
      "toString": {
        "state": "You trust them {value} out of 10.",
        "reason": "You trust {args[1]} {value} out of 10."
      }
    },
    "actionType": {
      "type": "boolean",
      "args": [
        "occurrence",
        "action"
      ],
      "privateFallback": "world-first"
    },
    "role": {
      "type": "boolean",
      "args": [
        "occurrence",
        "roleName",
        "entity"
      ],
      "privateFallback": "world-first"
    },
    "witnessed": {
      "type": "boolean",
      "args": [
        "occurrence",
        "agent"
      ],
      "toString": {
        "reason": "{args[1]} knows about \"{text[0]}\"."
      },
      "privateFallback": "world-first"
    },
    "judged": {
      "type": "boolean",
      "args": [
        "agent",
        "occurrence"
      ]
    },
    "work_occurrence": {
      "type": "boolean",
      "args": [
        "occurrence"
      ],
      "privateFallback": "world-first"
    },
    "social_occurrence": {
      "type": "boolean",
      "args": [
        "occurrence"
      ],
      "privateFallback": "world-first"
    },
    "change": {
      "type": "numeric",
      "args": [
        "occurrence",
        "agent",
        "quantity"
      ],
      "default": 0,
      "toString": {
        "reason": {
          "positive": "\"{text[0]}\" gave {args[1]} {abs} more {args[2]}.",
          "negative": "\"{text[0]}\" cost {args[1]} {abs} {args[2]}."
        }
      }
    },
    "responsible": {
      "type": "boolean",
      "args": [
        "occurrence",
        "agent"
      ],
      "privateFallback": "world-first",
      "toString": {
        "reason": "{args[1]} is responsible for \"{text[0]}\"."
      }
