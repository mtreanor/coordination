      "type": "boolean",
      "args": [
        "occurrence",
        "label"
      ],
      "toString": {
        "reason": "Your verdict on \"{text[0]}\": {args[1]}."
      }
    },
    "leftAlone": {
      "type": "derived",
      "args": [
        "agent"
      ],
      "toString": {
        "reason": "Nobody did anything to you this round that you can put a name to."
