{
  "predicates": {
    "energy": {
      "type": "numeric",
      "args": ["agent"],
      "minValue": 0, "maxValue": 10, "default": 5,
      "tiers": { "low": [0, 3], "ok": [3, 7], "high": [7, 10] }
    },
    "wood": {
      "type": "numeric",
      "args": ["agent"],
      "minValue": 0, "maxValue": 100, "default": 0
    },
    "warmth": {
      "type": "numeric",
      "args": ["agent", "agent"],
      "minValue": 0, "maxValue": 10, "default": 5
    },
    "urge-rest":   { "type": "numeric", "args": ["agent"], "annotations": { "ephemeral": true } },
    "urge-gather": { "type": "numeric", "args": ["agent"], "annotations": { "ephemeral": true } },
    "urge-share":  { "type": "numeric", "args": ["agent", "agent"], "annotations": { "ephemeral": true } }
  }
}
