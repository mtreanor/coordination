actionset "work-events"
  # Recording work events. The social layer reports each work event as a
  # report_<kind>(actor, target) fact; these actions turn each report into an
  # occurrence that its witnesses can judge, and clear the report. (Work state,
  # such as points, reaches RUE separately and directly, through the Mirror.)
  # Until RUE has external occurrences (docs/rue-upstream.md), witnesses are
  # written here: everyone the event involved except the actor.

  action "took from"
    roles: ?SELF: agent, ?OTHER: agent
    preconditions
      report_took_from(?SELF, ?OTHER)
    utility
      1
    content text: "?SELF took from ?OTHER"
    effects
      record(?occ)
      work_occurrence(?occ)
      witnessed(?occ, ?OTHER)
      not report_took_from(?SELF, ?OTHER)

  action "helped"
    roles: ?SELF: agent, ?OTHER: agent
    preconditions
      report_helped(?SELF, ?OTHER)
    utility
      1
    content text: "?SELF helped ?OTHER"
    effects
      record(?occ)
      work_occurrence(?occ)
      witnessed(?occ, ?OTHER)
      not report_helped(?SELF, ?OTHER)
