# Copy this file to .env (gitignored) and fill in the keys for the providers you use.
# Only the providers referenced by profiles in models.toml need a key.

ANTHROPIC_API_KEY=
# Only needed when the Anthropic key is not scoped to a workspace (Console → Settings → Workspaces).
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GOOGLE_API_KEY=
